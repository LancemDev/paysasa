DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
PAYPAL_ADAPTER=mock
MAX_AMOUNT_MINOR=1000000
# Rehearsal routes are off by default. When enabled they still require a signed-in
# user and only touch that user's rows.
ENABLE_DEV_ROUTES=false
AGENT_RATE_LIMIT_PER_MINUTE=20
CORS_ORIGIN=http://localhost:3000

# The mock adapter rejects every webhook unless this is set. Use a random value
# locally; leave it empty in production.
PAYPAL_MOCK_WEBHOOK_SECRET=

# From the PayPal teammate
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
