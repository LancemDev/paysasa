# Backend (FastAPI) base URL, no trailing slash
VITE_API_BASE_URL=http://localhost:8000

# Supabase project URL and PUBLIC anon key (row-level security protects the data)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# How the backend talks to PayPal: "mock" (in-memory, default) or "sandbox".
# The backend does not report this, so set it to match backend PAYPAL_ADAPTER.
VITE_PAYPAL_MODE=mock

# Show the clearly labelled Demo helper (needs backend ENABLE_DEV_ROUTES=true).
# Keep this false in production; enable both only for a rehearsal deployment.
VITE_ENABLE_DEMO=false

# Payouts at or above this amount (minor units, e.g. 50000 = 500.00) need a second confirmation
VITE_APPROVAL_SECOND_CONFIRM_MINOR=50000

# Optional AG Grid Enterprise licence key (row grouping). Without it AG Grid shows a trial watermark.
VITE_AG_GRID_LICENSE_KEY=

# Optional AG Studio licence key (Insights page). The hackathon's AG Grid partner offers a 45-day AG Studio trial.
VITE_AG_STUDIO_LICENSE_KEY=

# Optional: shown on the landing and sign-in pages so judges can log in to the SANDBOX demo account.
# Never put real credentials here; this value is public in the built site.
VITE_DEMO_LOGIN_HINT=
